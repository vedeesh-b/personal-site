---
import { Image } from 'astro:assets';

const { imgSrc, title, description, alt } = Astro.props;
---

<div class="container">
	<div class="feed-img">
		{
			imgSrc ? (
				<Image src={imgSrc} alt={alt} loading={'lazy'} />
			) : (
				<div class="emptyImg" />
			)
		}
	</div>
	<div class="title">{title}</div>
	<div class="description">{description}</div>
</div>

<style>
	.container {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.title {
		font-size: 18px;
		font-weight: 500;
		letter-spacing: -0.5px;
		color: #000;
	}

	.description {
		color: #545454;
		font-size: 16px;
		letter-spacing: -0.25px;
	}

	.emptyImg {
		height: 240px;
		width: 400px;
		border-radius: 12px;
		background-color: #d9d9d9;
	}
</style>
