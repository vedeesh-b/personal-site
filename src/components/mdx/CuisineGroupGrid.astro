---
/*
 * Charl's browse categories, styled after the app: a food icon, the group
 * name in Croissant One, a count of the OSM cuisine slugs it covers, and a
 * sample of those slugs.
 */
import '@fontsource/croissant-one/400.css';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Card {
	title: string;
	icon: ImageMetadata;
	badge: string;
	body: string;
}

interface Props {
	cards: Card[];
	caption?: string;
}

const { cards, caption } = Astro.props;
---

<figure class="cuisine-grid">
	<ul class="cards">
		{
			cards.map((card) => (
				<li class="card">
					<div class="card-heading">
						<span class="icon">
							<Image
								src={card.icon}
								alt=""
								width={28}
								height={28}
								densities={[1, 2]}
							/>
						</span>
						<span class="card-title">{card.title}</span>
					</div>
					<span class="badge">{card.badge}</span>
					<p class="card-body">{card.body}</p>
				</li>
			))
		}
	</ul>

	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.cuisine-grid {
		margin: 3rem 0;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		margin: 0;
		padding: 1.6rem;
		border-radius: 12px;
		border: #d9d9d9 1px solid;
		background: linear-gradient(45deg, #fff, #dcfed3);
	}

	.card-heading {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}

	.icon {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 8px;
		background-color: rgb(0 0 0 / 0.07);
	}

	.card-title {
		font-family: 'Croissant One', serif;
		font-size: 28px;
		line-height: 1.2;
		letter-spacing: -0.5px;
		color: #222;
	}

	.badge {
		display: inline-block;
		margin-top: 1.1rem;
		padding: 0.2rem 0.45rem;
		border: 1px solid #a6d99c;
		border-radius: 6px;
		background-color: #dcfed3;
		font-size: 11px;
		font-weight: 500;
		line-height: 16px;
		letter-spacing: 0.6px;
		text-transform: uppercase;
		color: #24502a;
	}

	.card-body {
		margin: 1rem 0 0;
		font-size: 18px;
		line-height: 1.6;
		letter-spacing: -0.2px;
		color: #6b6b6b;
	}

	figcaption {
		margin-top: 1.25rem;
		font-size: 13px;
		color: #6b6b6b;
	}

	@media (max-width: 640px) {
		.cards {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.card {
			padding: 1.25rem;
		}

		.card-title {
			font-size: 24px;
		}

		.card-body {
			font-size: 16px;
		}
	}
</style>
