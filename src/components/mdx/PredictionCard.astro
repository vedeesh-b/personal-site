---
/*
 * One tier of a GridLock card holding a single prediction, as the app draws
 * it. Shared by the figures that show a prediction: EditorToCard animates
 * into it, and the next-season concepts add to it through two slots:
 * `actions` sits at the right of the header, `footer` under a divider below
 * the prediction.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Highlight {
	/** A word or name in the prediction, matched case-insensitively. */
	text: string;
	color: string;
}

interface Props {
	tier: number;
	points: number;
	prediction: string;
	image: ImageMetadata;
	imageAlt: string;
	/** CSS object-position, for photos that need cropping toward a face. */
	imagePosition?: string;
	/** Colours names in the prediction, e.g. to tie them to a chart's lines. */
	highlights?: Highlight[];
}

const {
	tier,
	points,
	prediction,
	image,
	imageAlt,
	imagePosition = 'center',
	highlights = [],
} = Astro.props;

// Split the prediction into plain and highlighted runs, in reading order.
const lower = prediction.toLowerCase();
const marks = highlights
	.map((h) => ({ ...h, at: lower.indexOf(h.text.toLowerCase()) }))
	.filter((h) => h.at !== -1)
	.sort((a, b) => a.at - b.at);
const runs: { text: string; color?: string }[] = [];
let cursor = 0;
for (const mark of marks) {
	if (mark.at < cursor) continue;
	runs.push({ text: prediction.slice(cursor, mark.at) });
	runs.push({ text: prediction.slice(mark.at, mark.at + mark.text.length), color: mark.color });
	cursor = mark.at + mark.text.length;
}
runs.push({ text: prediction.slice(cursor) });

const hasActions = Astro.slots.has('actions');
const hasFooter = Astro.slots.has('footer');
---

<div class="prediction-card">
	<div class="card-header">
		<span class="tier">Tier {tier}</span>
		<span class="points">{points === 1 ? '1 Point' : `${points} Points`}</span>
		{
			hasActions && (
				<div class="actions">
					<slot name="actions" />
				</div>
			)
		}
	</div>
	<div class="item">
		<Image
			class="photo"
			src={image}
			alt={imageAlt}
			width={80}
			height={80}
			densities={[1, 2]}
			style={`object-position: ${imagePosition}`}
		/>
		<p class="item-text">
			{runs.map((run) => (run.color ? <span class="mark" style={`--mark: ${run.color}`}>{run.text}</span> : run.text))}
		</p>
		{
			hasFooter && (
				<div class="item-footer">
					<slot name="footer" />
				</div>
			)
		}
	</div>
</div>

<style>
	.prediction-card {
		--item-pad-x: 1.75rem;
		--item-pad-y: 1.5rem;

		padding: 1.5rem;
		border-radius: 14px;
		background-color: #2c2c2c;
	}

	.card-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 1.25rem;
	}

	.tier {
		font-size: 26px;
		font-weight: 500;
		letter-spacing: -0.5px;
		color: #c9c9c9;
	}

	.points {
		padding: 0.3rem 0.9rem;
		border-radius: 999px;
		background-color: #1f1f1f;
		font-size: 15px;
		color: #8e8e8e;
	}

	.actions {
		display: flex;
		align-items: center;
		margin-left: auto;
	}

	.item {
		padding: var(--item-pad-y) var(--item-pad-x);
		border-radius: 10px;
		background-color: #1f1f1f;
	}

	.photo {
		display: block;
		width: 80px;
		height: 80px;
		margin-bottom: 1.25rem;
		object-fit: cover;
		border: 2px solid #555;
		border-radius: 6px;
		/* Lets EditorToCard fly the photo over the editor above it. */
		position: relative;
		z-index: 1;
	}

	.item-text {
		max-width: 40ch;
		margin: 0;
		font-size: 20px;
		line-height: 1.35;
		letter-spacing: -0.3px;
		color: #fff;
	}

	.mark {
		color: var(--mark);
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 4px;
	}

	/* The divider runs edge to edge across the item. */
	.item-footer {
		margin: var(--item-pad-y) calc(var(--item-pad-x) * -1) 0;
		padding: var(--item-pad-y) var(--item-pad-x) 0;
		border-top: 1px solid #3a3a3a;
	}

	@media (max-width: 768px) {
		.prediction-card {
			--item-pad-x: 1.25rem;
			--item-pad-y: 1.25rem;

			padding: 1.25rem;
		}

		.tier {
			font-size: 22px;
		}

		.item-text {
			font-size: 17px;
		}
	}
</style>
