---
/*
 * A concept for next season: a prediction no results API can settle, so the
 * players vote on it. The thumbs work as a pair of toggles: picking one
 * clears the other, picking it again clears your vote. Nothing is saved, so
 * every page load starts with no vote cast.
 */
import type { ImageMetadata } from 'astro';
import PredictionCard from './PredictionCard.astro';

interface Props {
	tier: number;
	points: number;
	prediction: string;
	image: ImageMetadata;
	imageAlt: string;
	imagePosition?: string;
	highlights?: { text: string; color: string }[];
	caption?: string;
}

const { caption, ...card } = Astro.props;
---

<figure class="voted-prediction">
	<PredictionCard {...card}>
		<div class="vote" slot="actions" role="group" aria-label="Your vote">
			<span class="vote-label" aria-hidden="true">Your Vote:</span>
			<button type="button" class="vote-button" data-vote="up" aria-pressed="false" aria-label="It came true">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M7 10v12" />
					<path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z" />
				</svg>
			</button>
			<button type="button" class="vote-button" data-vote="down" aria-pressed="false" aria-label="It didn't come true">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M17 14V2" />
					<path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z" />
				</svg>
			</button>
		</div>
	</PredictionCard>

	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.voted-prediction {
		display: grid;
		gap: 1.25rem;
		margin: 3rem 0;
		padding: 1.25rem;
		border-radius: 16px;
		background-color: #f6f6f6;
	}

	.vote {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.vote-label {
		margin-right: 0.5rem;
		font-size: 20px;
		letter-spacing: -0.3px;
		color: #c9c9c9;
	}

	.vote-button {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background-color: #444;
		color: #9a9a9a;
		cursor: pointer;
		transition:
			background-color 200ms var(--ease-out),
			color 200ms var(--ease-out),
			transform 160ms var(--ease-out);
	}

	.vote-button svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (hover: hover) {
		.vote-button:hover {
			background-color: #4f4f4f;
			color: #d0d0d0;
		}
	}

	.vote-button:active {
		transform: scale(0.92);
	}

	.vote-button:focus-visible {
		outline: 2px solid #b48a46;
		outline-offset: 2px;
	}

	.vote-button[data-vote='up'][aria-pressed='true'] {
		background-color: rgb(52 199 89 / 0.2);
		color: #4cd17a;
	}

	.vote-button[data-vote='down'][aria-pressed='true'] {
		background-color: rgb(240 62 62 / 0.2);
		color: #ff5c5c;
	}

	.vote-button[aria-pressed='true'] svg {
		fill: currentColor;
		fill-opacity: 0.25;
	}

	figcaption {
		font-size: 13px;
		color: #6b6b6b;
	}

	@media (max-width: 768px) {
		.vote-label {
			font-size: 16px;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.voted-prediction .vote').forEach((group) => {
		const buttons = [...group.querySelectorAll<HTMLButtonElement>('.vote-button')];
		buttons.forEach((button) =>
			button.addEventListener('click', () => {
				const pressed = button.getAttribute('aria-pressed') === 'true';
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button && !pressed)));
			}),
		);
	});
</script>
