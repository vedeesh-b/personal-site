---
/*
 * A sequence diagram: one lifeline per participant, messages in time order
 * from top to bottom. Calls are solid with a filled arrowhead, replies are
 * dashed with an open one, and phase rows split the journey into stages.
 */

interface Participant {
	id: string;
	title: string;
	tech?: string;
}

interface Message {
	from: string;
	/** Same as `from` for work a participant does on its own. */
	to: string;
	label: string;
	/** Smaller line under the arrow, e.g. a condition or what's stored. */
	detail?: string;
	reply?: boolean;
}

type Step = Message | { phase: string };

interface Props {
	title: string;
	participants: Participant[];
	steps: Step[];
	caption?: string;
}

const { title, participants, steps, caption } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const WIDTH = 760;
const PAD = 12;
const HEADER = 56;
const MESSAGE_ROW = 56;
const SELF_ROW = 64;
const PHASE_ROW = 40;
const BOX_WIDTH = 150;

const column = (WIDTH - PAD * 2) / participants.length;
const xOf = new Map(
	participants.map((p, i) => [p.id, PAD + column * (i + 0.5)]),
);

// Walk the steps once, giving each its vertical position.
let y = HEADER + 16;
const placed = steps.map((step) => {
	if ('phase' in step) {
		const row = { ...step, y: y + 24 };
		y += PHASE_ROW;
		return row;
	}
	const self = step.from === step.to;
	const row = { ...step, self, y: y + 28 };
	y += self ? SELF_ROW : MESSAGE_ROW;
	return row;
});
const height = y + 12;
---

<figure class="sequence">
	<div class="diagram-title">{title}</div>
	<div class="scroller">
		<svg
			viewBox={`0 0 ${WIDTH} ${height}`}
			role="img"
			aria-label={title}
		>
			<defs>
				<marker
					id={`${slug}-call`}
					viewBox="0 0 10 10"
					refX="9"
					refY="5"
					markerWidth="7"
					markerHeight="7"
					orient="auto-start-reverse"
				>
					<path d="M 0 0 L 10 5 L 0 10 z" class="call-head" />
				</marker>
				<marker
					id={`${slug}-reply`}
					viewBox="0 0 10 10"
					refX="9"
					refY="5"
					markerWidth="8"
					markerHeight="8"
					orient="auto-start-reverse"
				>
					<path d="M 1 1 L 9 5 L 1 9" class="reply-head" />
				</marker>
			</defs>

			{
				participants.map((p) => {
					const x = xOf.get(p.id)!;
					return (
						<g class="participant">
							<line class="lifeline" x1={x} y1={HEADER} x2={x} y2={height - 8} />
							<rect x={x - BOX_WIDTH / 2} y="4" width={BOX_WIDTH} height={HEADER - 8} rx="10" />
							<text class="p-title" x={x} y={p.tech ? 24 : 32}>
								{p.title}
							</text>
							{p.tech && (
								<text class="p-tech" x={x} y="41">
									{p.tech}
								</text>
							)}
						</g>
					);
				})
			}

			{
				placed.map((step) => {
					if ('phase' in step) {
						return (
							<g class="phase">
								<line x1={PAD} y1={step.y} x2={WIDTH - PAD} y2={step.y} />
								<text x={PAD} y={step.y + 4}>
									{step.phase}
								</text>
							</g>
						);
					}

					const from = xOf.get(step.from)!;
					const to = xOf.get(step.to)!;

					// Work done in place: a small loop back onto the same lifeline.
					if (step.self) {
						return (
							<g class="message">
								<path
									class="call"
									d={`M ${from} ${step.y - 8} H ${from + 34} V ${step.y + 10} H ${from + 2}`}
									marker-end={`url(#${slug}-call)`}
								/>
								<text class="label start" x={from + 44} y={step.y + 2}>
									{step.label}
								</text>
								{step.detail && (
									<text class="detail start" x={from + 44} y={step.y + 18}>
										{step.detail}
									</text>
								)}
							</g>
						);
					}

					// Stop short of the lifeline so the arrowhead tip lands on it.
					const direction = Math.sign(to - from);
					const middle = (from + to) / 2;
					return (
						<g class="message">
							<line
								class={step.reply ? 'reply' : 'call'}
								x1={from}
								y1={step.y}
								x2={to - direction * 2}
								y2={step.y}
								marker-end={`url(#${slug}-${step.reply ? 'reply' : 'call'})`}
							/>
							<text class="label" x={middle} y={step.y - 8}>
								{step.label}
							</text>
							{step.detail && (
								<text class="detail" x={middle} y={step.y + 17}>
									{step.detail}
								</text>
							)}
						</g>
					);
				})
			}
		</svg>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.sequence {
		--ink: #222;
		--muted: #6b6b6b;
		--hairline: #e3e3e3;
		--line: #9a9a9a;

		margin: 3rem 0;
	}

	.diagram-title {
		margin: 0 0 1.5rem;
		font-size: 20px;
		font-weight: 500;
		letter-spacing: -0.3px;
		color: var(--ink);
	}

	/* Text in the SVG scales with it, so on narrow screens the diagram keeps
	   a readable size and scrolls inside its own frame instead. */
	.scroller {
		overflow-x: auto;
		overscroll-behavior-x: contain;
	}

	svg {
		display: block;
		width: 100%;
		min-width: 620px;
		height: auto;
		font-family: inherit;
	}

	.participant rect {
		fill: #fff;
		stroke: var(--hairline);
		stroke-width: 1.25;
	}

	.lifeline {
		stroke: #d6d6d6;
		stroke-dasharray: 3 4;
	}

	.p-title {
		font-size: 14px;
		font-weight: 500;
		letter-spacing: -0.24px;
		text-anchor: middle;
		fill: var(--ink);
	}

	.p-tech {
		font-size: 12px;
		text-anchor: middle;
		fill: var(--muted);
	}

	.phase line {
		stroke: var(--hairline);
	}

	/* Same treatment as the zone labels in FlowDiagram. */
	.phase text {
		font-size: 11.5px;
		letter-spacing: 0.8px;
		text-transform: uppercase;
		fill: var(--muted);
		paint-order: stroke;
		stroke: #fff;
		stroke-width: 10px;
		stroke-linejoin: round;
	}

	.call {
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.25;
	}

	.reply {
		stroke: var(--line);
		stroke-width: 1.25;
		stroke-dasharray: 5 4;
	}

	.call-head {
		fill: var(--ink);
	}

	.reply-head {
		fill: none;
		stroke: var(--line);
		stroke-width: 1.5;
	}

	.label {
		font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
		font-size: 12px;
		text-anchor: middle;
		fill: var(--ink);
	}

	.detail {
		font-size: 12px;
		text-anchor: middle;
		fill: var(--muted);
	}

	.label.start,
	.detail.start {
		text-anchor: start;
	}

	figcaption {
		margin-top: 1.25rem;
		font-size: 13px;
		color: var(--muted);
	}
</style>
