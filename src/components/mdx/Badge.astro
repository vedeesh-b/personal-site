---
interface Props {
	variant?: 'neutral' | 'accent';
}

const { variant = 'neutral' } = Astro.props;
---

<span class:list={['badge', variant]}><slot /></span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		padding: 0.15rem 0.6rem;
		margin: 0 0.25rem 0.25rem 0;
		border-radius: 999px;
		font-size: 13px;
		line-height: 20px;
		letter-spacing: -0.2px;
		white-space: nowrap;
		vertical-align: middle;
	}

	.neutral {
		background-color: #f0f0f0;
		color: #333;
	}

	.accent {
		background-color: #111;
		color: #fff;
	}
</style>
