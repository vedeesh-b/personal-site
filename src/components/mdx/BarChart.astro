---
interface Bar {
	label: string;
	value: number;
	/** Shown under the label, e.g. what makes up the number. */
	note?: string;
	/** Draws the bar in the primary ink; the rest stay muted. */
	highlight?: boolean;
}

interface Props {
	title: string;
	bars: Bar[];
	unit: string;
	caption?: string;
}

const { title, bars, unit, caption } = Astro.props;
const max = Math.max(...bars.map((bar) => bar.value));
---

<figure class="bar-chart">
	{/* A real table, so screen readers get the numbers; CSS draws it as bars. */}
	<table>
		<caption>{title}</caption>
		<thead class="visually-hidden">
			<tr>
				<th scope="col">Version</th>
				<th scope="col">Value ({unit})</th>
			</tr>
		</thead>
		<tbody>
			{
				bars.map(({ label, value, note, highlight }, index) => (
					<tr>
						<th scope="row">
							{label}
							{note && <span class="note">{note}</span>}
						</th>
						<td>
							<div class="bar-row">
								<span
									class:list={['bar', { highlight }]}
									style={`--width: ${(value / max) * 100}%; --index: ${index}`}
								/>
								<span class="value" style={`--index: ${index}`}>
									{value.toLocaleString('en-GB')} {unit}
								</span>
							</div>
						</td>
					</tr>
				))
			}
		</tbody>
	</table>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	figure {
		margin: 2.5rem 0;
		padding: 1.25rem;
		border-radius: 12px;
		background-color: #f6f6f6;
	}

	table {
		width: 100%;
		border-collapse: collapse;
	}

	caption {
		margin-bottom: 1rem;
		text-align: left;
		font-size: 14px;
		font-weight: 500;
		color: #111;
	}

	th,
	td {
		padding: 0.5rem 0;
		vertical-align: middle;
	}

	th {
		width: 9rem;
		padding-right: 1rem;
		text-align: left;
		font-size: 14px;
		font-weight: 500;
		color: #111;
	}

	.note {
		display: block;
		font-size: 12px;
		font-weight: 400;
		color: #6b6b6b;
	}

	.bar-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.bar {
		width: var(--width);
		min-width: 4px;
		height: 20px;
		border-radius: 0 4px 4px 0;
		background-color: #c4c4c4;
	}

	.bar.highlight {
		background-color: #111;
	}

	/* Reveal: only once the script opts in, so no-JS and reduced motion
	   render the finished chart. Bars grow from the axis, then the value
	   appears beside each one. */
	figure[data-animate] .bar {
		clip-path: inset(0 100% 0 0);
		transition: clip-path 600ms var(--ease-out);
		transition-delay: calc(var(--index) * 60ms);
	}

	figure[data-animate] .value {
		opacity: 0;
		transition: opacity 300ms var(--ease-out);
		transition-delay: calc(var(--index) * 60ms + 200ms);
	}

	figure[data-animate][data-visible] .bar {
		clip-path: inset(0 0 0 0);
	}

	figure[data-animate][data-visible] .value {
		opacity: 1;
	}

	.value {
		flex-shrink: 0;
		font-size: 13px;
		font-variant-numeric: tabular-nums;
		color: #545454;
	}

	figcaption {
		margin-top: 1rem;
		font-size: 13px;
		color: #6b6b6b;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 768px) {
		th {
			width: 6.5rem;
		}
	}
</style>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	// Grow the bars once, when most of the chart is on screen.
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				(entry.target as HTMLElement).dataset.visible = '';
				observer.unobserve(entry.target);
			}
		},
		{ threshold: 0.4 },
	);

	if (!reducedMotion.matches) {
		document.querySelectorAll<HTMLElement>('.bar-chart').forEach((chart) => {
			chart.dataset.animate = '';
			observer.observe(chart);
		});
	}
</script>
