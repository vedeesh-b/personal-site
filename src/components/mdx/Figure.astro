---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** An imported local image (optimised) or a remote URL. */
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
	{
		typeof src === 'string' ? (
			<img src={src} alt={alt} loading="lazy" />
		) : (
			<Image src={src} alt={alt} />
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	figure {
		margin: 2.5rem 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		background-color: #d9d9d9;
	}

	figcaption {
		margin-top: 0.75rem;
		font-size: 14px;
		color: #777;
	}
</style>
