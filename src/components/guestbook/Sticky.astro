---
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import type { HTMLTag } from 'astro/types';
import { Image } from 'astro:assets';
import blue from '../../assets/stickies/note-blue.png';
import green from '../../assets/stickies/note-green.png';
import pink from '../../assets/stickies/note-pink.png';
import sky from '../../assets/stickies/note-sky.png';
import teal from '../../assets/stickies/note-teal.png';
import yellow from '../../assets/stickies/note-yellow.png';

const papers = { blue, green, pink, sky, teal, yellow };

interface Props {
	/** Picks the paper and tilt. The same seed always gets the same note. */
	seed?: number;
	paper?: keyof typeof papers;
	/** Degrees. Defaults to a slight tilt picked by the seed. */
	tilt?: number;
	as?: HTMLTag;
	[attr: string]: unknown;
}

const {
	seed = 0,
	paper,
	tilt,
	as: Tag = 'div',
	style,
	...attrs
} = Astro.props;
const papersInOrder = Object.values(papers);
const src = paper
	? papers[paper]
	: papersInOrder[Math.abs(seed) % papersInOrder.length];
// A cheap hash, so neighbouring ids don't tilt in step. -2.5° to 2.5°.
const spread = ((Math.abs(seed) * 2654435761) % 4294967296) / 4294967296;
const angle = tilt ?? (spread - 0.5) * 5;
---

<Tag
	class="sticky"
	style={`--tilt: ${angle.toFixed(2)}deg;${style ? ` ${style}` : ''}`}
	{...attrs}
>
	<Image src={src} alt="" widths={[288, 576]} sizes="18rem" />
	<div class="content">
		<slot />
	</div>
</Tag>

<style>
	.sticky {
		position: relative;
		width: 18rem;
		aspect-ratio: 1;
		transform: rotate(var(--tilt));
		font-family: 'Caveat', cursive;
		font-size: 20px;
		line-height: 1.2;
		color: #1f2937;
	}

	img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.content {
		position: absolute;
		inset: 0;
		box-sizing: border-box;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
	}
</style>
