---
const SITE = 'https://photos.vedeeshbali.com';
const host = new URL(SITE).host;
---

<div class="photography">
	<!-- A live preview, not a window: it never takes the pointer, the wheel
	     or focus. The link on top handles everything. -->
	<iframe
		src={SITE}
		title="Photography portfolio preview"
		loading="lazy"
		tabindex="-1"
		aria-hidden="true"
		scrolling="no"></iframe>
	<a
		class="preview-link"
		href={SITE}
		target="_blank"
		rel="noopener noreferrer"
	>
		<span class="visually-hidden">Photography portfolio (opens in new tab)</span>
	</a>
	<div class="cursor-tip" aria-hidden="true">
		<span class="hint"
			><kbd class="mod">Ctrl</kbd> + click to open {host} ↗</span
		>
		<span class="ready">Click to open {host} ↗</span>
	</div>
	<span class="touch-pill" aria-hidden="true">Open site ↗</span>
</div>

<style>
	.photography {
		position: relative;
		height: 100%;
		overflow: hidden;
	}

	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		pointer-events: none;
	}

	/* Covers the preview, and blurs it while the pointer is over it. */
	.preview-link {
		position: absolute;
		inset: 0;
		background-color: rgb(246 239 228 / 0);
		backdrop-filter: blur(0);
		-webkit-backdrop-filter: blur(0);
		transition:
			backdrop-filter 250ms var(--ease-out),
			-webkit-backdrop-filter 250ms var(--ease-out),
			background-color 250ms var(--ease-out);
	}

	.preview-link:focus-visible {
		outline: 2px solid #111;
		outline-offset: -4px;
		border-radius: 16px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.cursor-tip {
		position: absolute;
		top: 0;
		left: 0;
		display: none;
		padding: 6px 10px;
		border-radius: 8px;
		background-color: #111;
		color: #fff;
		font-size: 13px;
		line-height: 1.3;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		scale: 0.95;
		transform-origin: top left;
		transition:
			opacity 150ms var(--ease-out),
			scale 150ms var(--ease-out);
	}

	kbd {
		display: inline-block;
		padding: 0 5px;
		border: 1px solid rgb(255 255 255 / 0.3);
		border-radius: 4px;
		font-family: inherit;
		font-size: 12px;
	}

	.ready {
		display: none;
	}

	.touch-pill {
		position: absolute;
		right: 12px;
		bottom: 12px;
		display: none;
		padding: 6px 12px;
		border-radius: 999px;
		background-color: #111;
		color: #fff;
		font-size: 13px;
		pointer-events: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.cursor-tip {
			display: block;
		}

		.photography:hover .preview-link,
		.preview-link:focus-visible {
			background-color: rgb(246 239 228 / 0.25);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
		}

		.photography:hover .cursor-tip {
			opacity: 1;
			scale: 1;
		}

		/* ⌘/Ctrl held: the click will open the site. */
		.photography[data-modifier] .preview-link {
			cursor: pointer;
			backdrop-filter: blur(2px);
			-webkit-backdrop-filter: blur(2px);
		}

		.photography[data-modifier] .hint {
			display: none;
		}

		.photography[data-modifier] .ready {
			display: inline;
		}

		.preview-link {
			cursor: default;
		}
	}

	@media not ((hover: hover) and (pointer: fine)) {
		.touch-pill {
			display: block;
		}
	}

	/* Browsers without backdrop-filter blur the preview itself. */
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		iframe {
			transition: filter 250ms var(--ease-out);
		}

		@media (hover: hover) and (pointer: fine) {
			.photography:hover iframe {
				filter: blur(6px);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.preview-link,
		.cursor-tip {
			transition: none;
		}
	}
</style>

<script>
	// Where the tip sits relative to the pointer, and how closely it follows
	// (share of the remaining distance covered each frame).
	const OFFSET_X = 12;
	const OFFSET_Y = 20;
	const FOLLOW = 0.25;
	const EDGE = 8;

	const isMac = /mac/i.test(
		(navigator as Navigator & { userAgentData?: { platform: string } })
			.userAgentData?.platform ?? navigator.platform,
	);
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLElement>('.photography').forEach((root) => {
		const link = root.querySelector<HTMLAnchorElement>('.preview-link')!;
		const tip = root.querySelector<HTMLElement>('.cursor-tip')!;
		if (isMac) root.querySelector('.mod')!.textContent = '⌘';

		let lastPointer = '';
		let hovering = false;
		let frame = 0;
		let target = { x: 0, y: 0 };
		let current = { x: 0, y: 0 };

		const setModifier = (held: boolean) => {
			if (held) root.dataset.modifier = '';
			else delete root.dataset.modifier;
		};

		// Keep the tip inside the slide, flipping it to the pointer's left or
		// above it near the right or bottom edges.
		const aim = (event: PointerEvent) => {
			const rect = root.getBoundingClientRect();
			const px = event.clientX - rect.left;
			const py = event.clientY - rect.top;
			let x = px + OFFSET_X;
			let y = py + OFFSET_Y;
			if (x + tip.offsetWidth > rect.width - EDGE) x = px - OFFSET_X - tip.offsetWidth;
			if (y + tip.offsetHeight > rect.height - EDGE) y = py - OFFSET_Y - tip.offsetHeight;
			target = {
				x: Math.max(EDGE, x),
				y: Math.max(EDGE, y),
			};
		};

		const render = () => {
			tip.style.translate = `${current.x}px ${current.y}px`;
		};

		const follow = () => {
			current.x += (target.x - current.x) * FOLLOW;
			current.y += (target.y - current.y) * FOLLOW;
			render();
			const settled =
				Math.abs(target.x - current.x) < 0.1 &&
				Math.abs(target.y - current.y) < 0.1;
			frame = hovering && !settled ? requestAnimationFrame(follow) : 0;
		};

		const onKey = (event: KeyboardEvent) =>
			setModifier(event.metaKey || event.ctrlKey);

		root.addEventListener('pointerenter', (event) => {
			if (event.pointerType !== 'mouse') return;
			hovering = true;
			aim(event);
			// Appear at the pointer rather than sliding in from the corner.
			current = { ...target };
			render();
			setModifier(event.metaKey || event.ctrlKey);
			addEventListener('keydown', onKey);
			addEventListener('keyup', onKey);
		});

		root.addEventListener('pointermove', (event) => {
			if (event.pointerType !== 'mouse') return;
			aim(event);
			setModifier(event.metaKey || event.ctrlKey);
			if (reducedMotion.matches) {
				current = { ...target };
				render();
			} else if (!frame) {
				frame = requestAnimationFrame(follow);
			}
		});

		root.addEventListener('pointerleave', () => {
			hovering = false;
			cancelAnimationFrame(frame);
			frame = 0;
			setModifier(false);
			removeEventListener('keydown', onKey);
			removeEventListener('keyup', onKey);
		});

		link.addEventListener('pointerdown', (event) => {
			lastPointer = event.pointerType;
		});

		// With a mouse, only ⌘/Ctrl-click opens it, so the preview can be
		// browsed past without leaving. Keyboard (Enter) and touch always open
		// it; middle-click is native.
		link.addEventListener('click', (event) => {
			const keyboard = event.detail === 0;
			if (
				lastPointer === 'mouse' &&
				!keyboard &&
				!event.metaKey &&
				!event.ctrlKey
			) {
				event.preventDefault();
			}
			lastPointer = '';
		});
	});
</script>
