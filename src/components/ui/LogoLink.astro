---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	href: string;
	/** Optional logo before the text. Wins over the `icon` slot. */
	logo?: ImageMetadata;
	/** Alt text for the logo. Empty by default: the text already names it. */
	logoAlt?: string;
}

const { href, logo, logoAlt = '' } = Astro.props;
const external = /^https?:\/\//.test(href);
// Anything (an inline SVG, a Lucide icon) can go before the text instead.
const hasIcon = !logo && Astro.slots.has('icon');
---

<span class="logo-link">
	<a
		href={href}
		target={external ? '_blank' : undefined}
		rel={external ? 'noopener noreferrer' : undefined}
	>
		{
			logo ? (
				<Image class="mark" src={logo} alt={logoAlt} width={32} height={32} />
			) : (
				hasIcon && (
					<span class="mark" aria-hidden="true">
						<slot name="icon" />
					</span>
				)
			)
		}<span class="label"><slot /></span>{
			external && <span class="visually-hidden"> (opens in new tab)</span>
		}
	</a>
</span>

<style>
	/* Inline, and takes its font, case and color from the text around it. */
	a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: #c4c4c4;
		text-underline-offset: 3px;
		transition:
			text-decoration-color 200ms var(--ease-out),
			color 200ms var(--ease-out);
	}

	a:hover {
		color: #111;
		text-decoration-color: currentColor;
	}

	.mark {
		display: inline-block;
		width: 1em;
		height: 1em;
		margin-right: 0.3em;
		vertical-align: -0.125em;
		border-radius: 3px;
		object-fit: contain;
		transition: scale 200ms var(--ease-out);
	}

	/* An icon in the slot fills the same 1em box. */
	.mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (hover: hover) and (pointer: fine) {
		a:hover .mark {
			scale: 1.08;
		}
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		a,
		.mark {
			transition: none;
		}
	}
</style>
