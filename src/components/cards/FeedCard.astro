---
import { Image } from 'astro:assets';

const { href, imgSrc, videoSrc, title, description, alt, transitionName } = Astro.props;
---

<a class="container" href={href} data-feed-card>
	<!-- The wrapper morphs into the project page's cover, so a click mid-video carries the current frame across. -->
	<div
		class="media"
		style={transitionName && `view-transition-name: ${transitionName}; view-transition-class: project-cover`}
	>
		{imgSrc ? <Image src={imgSrc} alt={alt} loading={'lazy'} /> : <div class="emptyImg" />}
		{
			videoSrc && (
				// Nothing downloads until the card nears the viewport; the image stays visible until frames arrive.
				<video src={videoSrc} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" />
			)
		}
	</div>
	<div>
		<div class="title">{title}</div>
		<div class="description">{description}</div>
	</div>
</a>

<style>
	.container {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
		color: inherit;
		text-decoration: none;
	}

	.media {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
	}

	.emptyImg,
	.media :global(img),
	video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.emptyImg,
	.media :global(img) {
		transition: opacity 0.2s ease;
	}

	video {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		/* Leaving fades out quicker than entering fades in, so the card settles fast. */
		transition: opacity 0.2s var(--ease-out, ease-out);
	}

	video.playing {
		opacity: 1;
		transition-duration: 0.35s;
	}

	/* Touch screens fire :hover on tap and leave it stuck, so only dim on real hover. */
	@media (hover: hover) and (pointer: fine) {
		.container:hover .emptyImg,
		.container:hover :global(img) {
			opacity: 0.85;
		}

		/* The video replaces the dim as the hover feedback. */
		.container:has(video):hover .emptyImg,
		.container:has(video):hover :global(img) {
			opacity: 1;
		}
	}

	.container:focus-visible {
		outline: 2px solid #111;
		outline-offset: 4px;
		border-radius: 12px;
	}

	.title {
		font-size: 18px;
		font-weight: 500;
		letter-spacing: -0.5px;
		color: #000;
		max-width: 30ch;
		padding-bottom: 0.4rem;
	}

	.description {
		color: #545454;
		font-size: 16px;
		letter-spacing: -0.25px;
		max-width: 36ch;
	}

	.emptyImg {
		background-color: #d9d9d9;
	}
</style>

<script>
	const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const wantsVideo = () => canHover.matches && !reducedMotion.matches;

	// Buffer each video as its card approaches, so the first hover starts instantly.
	const preloader = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting || !wantsVideo()) continue;
				const video = entry.target.querySelector('video')!;
				video.preload = 'auto';
				video.load();
				preloader.unobserve(entry.target);
			}
		},
		{ rootMargin: '300px' },
	);

	for (const card of document.querySelectorAll<HTMLAnchorElement>('[data-feed-card]')) {
		const video = card.querySelector('video');
		if (!video) continue;
		preloader.observe(card);

		let hovered = false;

		// Only reveal once frames are actually painting, so a slow load never flashes an empty box.
		video.addEventListener('playing', () => {
			if (hovered) video.classList.add('playing');
			else video.pause(); // The pointer left before playback began.
		});

		const start = () => {
			if (!wantsVideo()) return;
			hovered = true;
			video.play().catch(() => {});
		};

		const stop = () => {
			hovered = false;
			video.classList.remove('playing');
			video.pause();
		};

		// Rewind once it has faded out, so the next hover starts from the top without a visible jump.
		video.addEventListener('transitionend', () => {
			if (!hovered) video.currentTime = 0;
		});

		card.addEventListener('pointerenter', start);
		card.addEventListener('pointerleave', stop);
		card.addEventListener('focus', start);
		card.addEventListener('blur', stop);
		// Coming back from the project page restores this page mid-hover; start it fresh.
		window.addEventListener('pageshow', (event) => event.persisted && stop());
	}
</script>
