---
const { date, content, avatar, categories } = Astro.props
---

<div class="post-container">
    <div class="header">
        {avatar ? <img src={avatar} alt="Vedeesh Bali" /> : <div class="avatar-placeholder" />}
        <div class="meta">
            <div class="username">@vedeeshb</div>
            <div class="name">Vedeesh Bali</div>
        </div>
    </div>
    <div class="body">{content}</div>
    <div class="footer">
        <div class="date">{date}</div>
        {categories?.map((category: string) => <span>{category}</span>)}
    </div>
</div>

<style>
    .post-container {
        background-color: #fff;
        border: #CDCDCD 1px solid;
        border-radius: 12px;
        padding: 12px 16px;
    }

    .header {
        display: flex;
        flex-direction: row;
        gap: 12px;
        padding-bottom: 16px;
    }

    .avatar-placeholder {
        height: 48px;
        width: 48px;
        border-radius: 100%;
        background-color: #F6EFE4;
    }

    .meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
        align-items: start;
        justify-content: center;
    }

    .username {
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }

    .name {
        color: #808080;
        font-size: 13px;
    }

    .footer {
        border-top: #CDCDCD 1px solid;
        padding-top: 12px;
    }

    .date {
        font-size: 14px;
    }
</style>